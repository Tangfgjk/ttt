APP_NAME=TTT Annotation Backend
APP_ENV=local
APP_DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/ttt_annotation
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
ENABLE_DOCS=true
IMPORT_UPLOAD_DIR=uploads/imports
EMBEDDING_MODEL_PATH=/absolute/path/to/math_mlm_model
ACTIVE_LEARNING_WORKER_PYTHON=
ACTIVE_LEARNING_GPU_WORKER_PYTHON=
